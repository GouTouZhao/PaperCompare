# ==============================================================================
# PaperCompare Environment Variables Template
# ==============================================================================

# LLM API Key (DashScope Qwen-Plus)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Database Configuration
MYSQL_HOST=host.minikube.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=papercompare

# PostgreSQL (for Docker Compose standalone setup)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=papercompare

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Storage Configuration
STORAGE_DATA_DIR=/data/storage

